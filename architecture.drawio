id="q1c41" value="scored records &lt;font color=&quot;#FF0000&quot;&gt;(every payment + its logged features)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1flink" target="q1live"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="909" y="369"/></Array></mxGeometry></mxCell><mxCell id="q1c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1flink" target="q1ddb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c43" value="flagged + &lt;font color=&quot;#FF0000&quot;&gt;deterministic 0.3%&lt;/font&gt;&lt;br&gt;audit sample of unflagged&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;(with SHAP risk factors)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="390" y="505" width="210" height="50" as="geometry"/></mxCell><mxCell id="q1c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1c19" target="q1ddb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c45" value="&lt;font color=&quot;#FF0000&quot;&gt;claim,&lt;/font&