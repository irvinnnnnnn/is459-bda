=1;jumpStyle=arc;jumpSize=10;strokeColor=#FF0000;strokeWidth=1.5;fontSize=11;fontColor=#FF0000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1trig" target="q1glexp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="676" y="501"/></Array></mxGeometry></mxCell><mxCell id="q1c50" value="&lt;font color=&quot;#FF0000&quot;&gt;labels/export_date=…/&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1glexp" target="q1live"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c51" value="&lt;font color=&quot;#FF0000&quot;&gt;last 7 days&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#FF0000;strokeWidth=1.5;fontSize=11;fontColor=#FF0000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1glfeat" target="q1seed"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="827.6"/><mxPoint x="185" y="694"/></Array></mxGeometry></mxCell><mxCell id="q1c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;dashPattern=8 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1seed" target="q1flink"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="103" y="487"/><mxPoint x="480.4" y="487"/></Array></mxGeometry></mxCell><mxCell id="q1c53" value="&lt;b&gt;② Seed Flink state&lt;/b&gt;&lt;br&gt;(last 7 days, at &lt;font color=&quot;#FF0000&quot;&gt;first&lt;/font&gt; start&lt;font color=&quot;#FF0000&quot;&gt;;&lt;br&gt;read from state/flink_seed/&lt;/font&gt;)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="200" height="50" as="geometry"/></mxCell><mxCell id="q1c54" value="&lt;font color=&quot;#FF0000&quot;&gt;poll models/best/manifest.json every 30 s&lt;/font&gt; → load the &lt;font color=&quot;#FF0000&quot;&gt;model.json&lt;/font&gt; it points to → hot-reload &lt;font color=&quot;#FF0000&quot;&gt;(each scorer polls S3; no broadcast state)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;dashPattern=8 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1models" target="q1flink"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1851" y="449"/><mxPoint x="511.6" y="449"/></Array></mxGeometry></mxCell><mxCell id="q1c55" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q1hist" target="q1glfeat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q1glfeat" target="q1curhist"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c57" value="historical rows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1curhist" target="q1build"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1live" target="q1build"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c59" value="live rows (txn + features)&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;labels/ ⋈ scored/ on txn_id&lt;br&gt;(reviewed payments only)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="915" y="728" width="190" height="50" as="geometry"/></mxCell><mxCell id="q1c60" value="③ trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="q1eb6"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="930" as="targetPoint"/><Array as="points"><mxPoint x="790" y="954"/><mxPoint x="790" y="930"/></Array></mxGeometry></mxCell><mxCell id="q1c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q1build" target="q1train"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c62" value="train / val" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q1train" target="q1smt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c63" value="test/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1train" target="q1smp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1078" y="769"/><mxPoint x="1469" y="769"/></Array></mxGeometry></mxCell><mxCell id="q1c64" value="write artifact &lt;font color=&quot;#FF0000&quot;&gt;→ models/artifacts/run=…/&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1smt" target="q1models"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1286" y="656"/><mxPoint x="1832" y="656"/></Array></mxGeometry></mxCell><mxCell id="q1c65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q1smt" target="q1smp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c66" value="&lt;font color=&quot;#FF0000&quot;&gt;evaluation.json + candidate manifest.json&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#FF0000;strokeWidth=1.5;fontSize=11;fontColor=#FF0000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1smp" target="q1models"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1488.5" y="678"/><mxPoint x="1878.3" y="678"/></Array></mxGeometry></mxCell><mxCell id="q1c67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q1smp" target="q1c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c68" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q1c31" target="q1reg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;dashPattern=8 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1reg" target="q1models"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q1c70" value="on approval:&lt;br&gt;update pointer&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;(separate Promote step: S3 copy&lt;br&gt;of the run&amp;#39;s manifest.json →&lt;br&gt;models/best/manifest.json;&lt;br&gt;runs even if registering fails)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1886" y="618" width="210" height="95" as="geometry"/></mxCell><mxCell id="q1c71" value="&lt;b&gt;Real architecture changes (keep these when deploying for real)&lt;/b&gt;&lt;ol style='margin:4px 0 0 0;padding-left:20px'&gt;&lt;li&gt;Firehose files raw/ by the transaction's own date (&lt;b&gt;raw/transactions/date=…/&lt;/b&gt;, dynamic partitioning); the Parquet schema comes from the Glue Data Catalog table raw_transactions.&lt;/li&gt;&lt;li&gt;Flink keeps only payments that involve our bank, and writes rejected records with the reason to &lt;b&gt;dlq/&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;② The Flink seed is &lt;b&gt;state/flink_seed/&lt;/b&gt;, written by Glue job ① (last 7 days), not read straight from historical/. It is loaded when Flink starts without saved state.&lt;/li&gt;&lt;li&gt;The audit sample is a &lt;b&gt;deterministic 0.3%&lt;/b&gt; (hash of txn_id), so a replayed or retried payment gets the same answer.&lt;/li&gt;&lt;li&gt;Model hot-reload: each scorer checks &lt;b&gt;models/best/manifest.json&lt;/b&gt; (ETag) every 30 s and loads the model.json it names. There is no Flink broadcast state.&lt;/li&gt;&lt;li&gt;The daily DynamoDB → S3 step is a &lt;b&gt;Glue Python-shell job (q1-label-export)&lt;/b&gt; started by a &lt;b&gt;Glue scheduled trigger&lt;/b&gt; (00:00 SGT), not EventBridge (an EventBridge rule cannot target a Glue job directly). It writes each closed item's final outcome to curated/live/labels/ and then deletes it.&lt;/li&gt;&lt;li&gt;Streamlit runs on an &lt;b&gt;EC2 instance (t3.small, port 8501)&lt;/b&gt;. Investigators can also &lt;b&gt;claim&lt;/b&gt; an alert. For a customer's payment history the app queries &lt;b&gt;Athena&lt;/b&gt; over curated/live/scored/ (table live_scored).&lt;/li&gt;&lt;li&gt;Training: &lt;b&gt;run=&amp;lt;run_id&amp;gt;&lt;/b&gt; (start date + execution id), &lt;b&gt;N = 6&lt;/b&gt; months, split &lt;b&gt;60/20/20 by time&lt;/b&gt;. The Processing job compares champion vs challenger (PR-AUC, recall at top 1%) and writes evaluation.json + manifest.json.&lt;/li&gt;&lt;li&gt;Promotion is its own Step Functions step (&lt;b&gt;S3 copy → models/best/manifest.json&lt;/b&gt;) after the model is registered as Approved; it still runs if registering fails.&lt;/li&gt;&lt;li&gt;The 6-monthly retrain runs on &lt;b&gt;1 Jan and 1 Jul&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;New: a &lt;b&gt;CloudWatch alarm&lt;/b&gt; when a Kinesis consumer is more than 60 s behind.&lt;/li&gt;&lt;/ol&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#FF0000;strokeColor=#FF0000;fillColor=#FFF5F5;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1180" height="300" as="geometry"/></mxCell><mxCell id="q1c72" value="&lt;b&gt;Only because of the demo (no choice if you simulate time)&lt;/b&gt;&lt;ol style='margin:4px 0 0 0;padding-left:20px'&gt;&lt;li&gt;No real core banking feed: &lt;b&gt;producer.py replay&lt;/b&gt; sends the IBM AML transactions into Kinesis on a &lt;b&gt;simulated clock&lt;/b&gt; (saved to state/sim_clock.json).&lt;/li&gt;&lt;li&gt;historical/ (history.csv) is uploaded once by &lt;b&gt;producer.py upload&lt;/b&gt;; a bank would load its case history itself.&lt;/li&gt;&lt;li&gt;The schedules (6-monthly retrain, daily label export) are created &lt;b&gt;disabled&lt;/b&gt; (enable_schedules = false), because they run on the real clock. Instead producer.py --labels starts the export at each &lt;b&gt;simulated&lt;/b&gt; midnight, and pipeline.py setup / start / retrain start the rest. For a real deployment set enable_schedules = true.&lt;/li&gt;&lt;li&gt;The label export and the Streamlit app judge &quot;7 days&quot; and &quot;now&quot; by the simulated clock when one is running (the real time otherwise), so no change is needed for real use.&lt;/li&gt;&lt;/ol&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#0066CC;strokeColor=#0066CC;fillColor=#F0F6FF;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1240" y="1080" width="740" height="198" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="q2" name="Q2 – daily KYC scoring"><mxGraphModel dx="2000" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q2c1" value="QUESTION 2" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#232F3E;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#8B7348;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="105" y="30" width="300" height="40" as="geometry"/></mxCell><mxCell id="q2c2" value="G2T2" style="text;html=1;align=right;verticalAlign=middle;fontSize=26;fontColor=#232F3E;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#8B7348;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1780" y="30" width="140" height="40" as="geometry"/></mxCell><mxCell id="q2c3" value="Architecture Diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=52;fontColor=#232F3E;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#2B1D16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="100" width="900" height="80" as="geometry"/></mxCell><mxCell id="q2c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#8B7348;strokeWidth=1;fontSize=11;fontColor=#8B7348;labelBackgroundColor=#ffffff;endArrow=none;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105" y="190" as="sourcePoint"/><mxPoint x="1900" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2c5" value="&lt;b&gt;Legend&lt;/b&gt; (vs the original slide, checked against main/infra/*.tf and the job code)&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;Red&lt;/b&gt; = real architecture change: stays when deployed for real&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#0066CC&quot;&gt;&lt;b&gt;Blue&lt;/b&gt; = only because of the demo: replayed data, simulated clock, jobs started by scripts&lt;/font&gt;&lt;br&gt;Black = same as the original" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#232F3E;strokeColor=#999999;dashed=1;fillColor=#FAFAFA;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1260" y="100" width="640" height="72" as="geometry"/></mxCell><mxCell id="q2c6" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#f5f5f5;strokeColor=#888888;arcSize=4;" vertex="1" parent="1"><mxGeometry x="32" y="283" width="511" height="327" as="geometry"/></mxCell><mxCell id="q2c7" value="&lt;b&gt;Shared with Q1&lt;/b&gt; (see Q1 diagram)&lt;br&gt;core banking → Kinesis → Firehose:&lt;br&gt;transactions stored as Parquet" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="45" y="290" width="320" height="55" as="geometry"/></mxCell><mxCell id="q2c8" value="" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_step_functions_workflow;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="606" y="283" width="915" height="497" as="geometry"/></mxCell><mxCell id="q2c9" value="&lt;b&gt;Daily KYC scoring — Step Functions workflow&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=15;fontColor=#232F3E;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#CD2264;" vertex="1" parent="1"><mxGeometry x="1050" y="292" width="460" height="25" as="geometry"/></mxCell><mxCell id="q2kds" value="Kinesis Data Streams&lt;br&gt;(partition key = account ID)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_streams;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2fh" value="Firehose&lt;br&gt;(→ Parquet)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_firehose;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="272" y="360" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2raw" value="Raw Data S3&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;raw/transactions/&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="412" y="360" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2curhist" value="&lt;b&gt;curated/historical/&lt;/b&gt;&lt;br&gt;case history transactions&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;(used for dates before live_start)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="412" y="502" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2c14" value="&lt;b&gt;Customer master DB&lt;/b&gt;&lt;br&gt;(core banking / KYC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="24" y="725" width="217" height="77" as="geometry"/></mxCell><mxCell id="q2c15" value="&lt;b&gt;yahoo finance&lt;/b&gt;&lt;br&gt;FX rates API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="24" y="872" width="217" height="77" as="geometry"/></mxCell><mxCell id="q2rawref" value="&lt;b&gt;raw/&lt;/b&gt;&lt;br&gt;accounts + FX (CSV)&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;accounts/snapshot_date=…/, fx/&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="412" y="797" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2lam" value="&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;Lambda&lt;/b&gt; q2-resolve-run-date&lt;br&gt;run_date = the given date, else yesterday&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#0066CC&quot;&gt;(by the simulated clock when one runs)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="850" y="318" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2glue" value="&lt;b&gt;Glue job&lt;/b&gt; (incremental: new dates only&lt;font color=&quot;#FF0000&quot;&gt; + run_date&lt;/font&gt;)&lt;br&gt;read raw accounts + FX + daily txn&lt;br&gt;clean, transform, validate&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;+ USD amounts; rejects → dlq/&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="737" y="475" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2cust" value="&lt;b&gt;curated/customer_txns/&lt;/b&gt;&lt;br&gt;txn, customer_id &lt;font color=&quot;#FF0000&quot;&gt;+ USD&lt;/font&gt; by date" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="993" y="475" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2emr" value="&lt;b&gt;EMR cluster&lt;/b&gt; &lt;font color=&quot;#FF0000&quot;&gt;(transient: created → 1 Spark step → terminated)&lt;/font&gt;&lt;br&gt;aggregate customer transaction records&lt;font color=&quot;#FF0000&quot;&gt; (7-day window)&lt;/font&gt;,&lt;br&gt;score and rank customers using predefined rules&lt;font color=&quot;#FF0000&quot;&gt; R1–R12&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.emr;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="1273" y="475" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2scores" value="&lt;b&gt;scores/run_date=…/&lt;/b&gt;&lt;br&gt;score + rules fired&lt;br&gt;per customer&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;+ rule_hits/, rule_eval/&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1590" y="475" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2eb" value="EventBridge schedule&lt;br&gt;(daily&lt;font color=&quot;#FF0000&quot;&gt;, 00:30 SGT&lt;/font&gt;&lt;font color=&quot;#0066CC&quot;&gt;; created disabled&lt;/font&gt;)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1590" y="283" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2athena" value="&lt;b&gt;Athena&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1590" y="657" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2cat" value="&lt;b&gt;Glue Data Catalog&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;tables defined in Terraform,&lt;br&gt;partition projection (no crawlers)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.glue_data_catalog;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="1800" y="632" width="80" height="80" as="geometry"/></mxCell><mxCell id="q2dec" value="&lt;b&gt;decisions/&lt;/b&gt;&lt;br&gt;decision history&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;(append-only events, date=…/)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="1273" y="797" width="78" height="78" as="geometry"/></mxCell><mxCell id="q2c26" value="&lt;b&gt;Streamlit&lt;/b&gt; &lt;font color=&quot;#FF0000&quot;&gt;on EC2 :8502&lt;/font&gt;&lt;br&gt;prioritised EDD queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#E85450;strokeWidth=2;fontColor=#232F3E;fontSize=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1520" y="806" width="232" height="68" as="geometry"/></mxCell><mxCell id="q2c27" value="KYC analysts" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1920" y="797" width="40" height="80" as="geometry"/></mxCell><mxCell id="q2c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q2kds" target="q2fh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q2fh" target="q2raw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2raw" target="q2glue"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="756.5" y="399"/></Array></mxGeometry></mxCell><mxCell id="q2c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2curhist" target="q2glue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2rawref" target="q2glue"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="575" y="836"/><mxPoint x="575" y="537.4"/></Array></mxGeometry></mxCell><mxCell id="q2c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2c14" target="q2rawref"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="763.5"/><mxPoint x="295" y="820.4"/></Array></mxGeometry></mxCell><mxCell id="q2c34" value="&lt;font color=&quot;#0066CC&quot;&gt;one-off upload&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#0066CC&quot;&gt;(producer.py upload)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="250" y="770" width="150" height="34" as="geometry"/></mxCell><mxCell id="q2c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2c15" target="q2rawref"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="910.5"/><mxPoint x="295" y="855.5"/></Array></mxGeometry></mxCell><mxCell id="q2c36" value="&lt;font color=&quot;#0066CC&quot;&gt;fetched once for the dataset's&lt;br&gt;dates (producer.py fx)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="250" y="915" width="190" height="34" as="geometry"/></mxCell><mxCell id="q2c37" value="&lt;font color=&quot;#FF0000&quot;&gt;run_date&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#FF0000;strokeWidth=1.5;fontSize=11;fontColor=#FF0000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2lam" target="q2glue"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="889" y="440"/><mxPoint x="795.5" y="440"/></Array></mxGeometry></mxCell><mxCell id="q2c38" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;dashPattern=8 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="q2eb"><mxGeometry relative="1" as="geometry"><mxPoint x="1521" y="390" as="targetPoint"/><Array as="points"><mxPoint x="1629" y="390"/></Array></mxGeometry></mxCell><mxCell id="q2c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q2glue" target="q2cust"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q2cust" target="q2emr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q2emr" target="q2scores"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c42" value="get high risk&lt;br&gt;customer data and score" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="q2scores" target="q2athena"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;dashPattern=8 4;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2cat" target="q2athena"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.47;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2athena" target="q2c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c45" value="stores decision&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;(one Parquet event per decision)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0;exitY=0.44;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2c26" target="q2dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c46" value="decide&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;(claim, EDD needed,&lt;br&gt;cleared until)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2c27" target="q2c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c47" value="latest decision per customer&lt;br&gt;for the next day risk calculations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2dec" target="q2emr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q2c48" value="latest decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2dec" target="q2athena"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1331.5" y="727"/></Array></mxGeometry></mxCell><mxCell id="q2c49" value="&lt;b&gt;Real architecture changes (keep these when deploying for real)&lt;/b&gt;&lt;ol style='margin:4px 0 0 0;padding-left:20px'&gt;&lt;li&gt;New first step: a &lt;b&gt;Lambda (q2-resolve-run-date)&lt;/b&gt; fixes run_date once (the given date, else yesterday), so Glue and EMR always work on the same day.&lt;/li&gt;&lt;li&gt;The daily EventBridge rule runs at &lt;b&gt;00:30 SGT&lt;/b&gt; (cron 30 16 * * ? * UTC).&lt;/li&gt;&lt;li&gt;raw/ is laid out as &lt;b&gt;raw/accounts/snapshot_date=…/&lt;/b&gt; (the customer file applies from its snapshot date) and &lt;b&gt;raw/fx/&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;Glue q2-etl handles the dates missing from curated/customer_txns/ &lt;b&gt;plus run_date&lt;/b&gt;. Dates before live_start come from curated/historical/, later ones from raw/transactions/. It adds USD amounts, sends rejects to &lt;b&gt;dlq/&lt;/b&gt;, and fails the run (writing nothing) if an account has no customer or a day has no FX rate.&lt;/li&gt;&lt;li&gt;EMR is &lt;b&gt;transient&lt;/b&gt;: the workflow creates the cluster (emr-7.1.0, 1 master + 2 core m5.xlarge), runs one spark-submit step (q2_score.py), then terminates it, even if the step fails.&lt;/li&gt;&lt;li&gt;EMR reads the 7 days ending on run_date from curated/customer_txns/, plus decisions/, the previous scores/ partition and state/cp_first_seen/. It writes scores/, &lt;b&gt;rule_hits/&lt;/b&gt;, &lt;b&gt;rule_eval/&lt;/b&gt; and state/cp_first_seen/.&lt;/li&gt;&lt;li&gt;Streamlit runs on &lt;b&gt;EC2 (t3.small, port 8502, shared with the Q1 app)&lt;/b&gt;. Through Athena it reads scores/, rule_eval/, curated/customer_txns/ and decisions/. It writes each decision as one small Parquet file to decisions/date=…/.&lt;/li&gt;&lt;li&gt;Glue Data Catalog tables are &lt;b&gt;defined in Terraform with partition projection&lt;/b&gt;, so no crawlers are needed. Athena uses the &lt;b&gt;aml&lt;/b&gt; workgroup.&lt;/li&gt;&lt;/ol&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#FF0000;strokeColor=#FF0000;fillColor=#FFF5F5;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1180" height="249" as="geometry"/></mxCell><mxCell id="q2c50" value="&lt;b&gt;Only because of the demo (no choice if you simulate time)&lt;/b&gt;&lt;ol style='margin:4px 0 0 0;padding-left:20px'&gt;&lt;li&gt;The EventBridge rule is created &lt;b&gt;disabled&lt;/b&gt;, because it runs on the real clock. In the demo, &lt;b&gt;producer.py replay --q2&lt;/b&gt; starts the workflow at each &lt;b&gt;simulated&lt;/b&gt; midnight with that day as run_date. For a real deployment set enable_schedules = true.&lt;/li&gt;&lt;li&gt;The Lambda reads the &lt;b&gt;simulated clock&lt;/b&gt; (state/sim_clock.json) when one is running; otherwise it uses the real date.&lt;/li&gt;&lt;li&gt;Customer master and FX are &lt;b&gt;not daily feeds&lt;/b&gt; in the demo: the dataset is fixed, so producer.py upload puts the accounts CSV in S3 once, and producer.py fx fetches the FX rates for the dataset's dates once with yfinance. Real use would keep the daily export and daily fetch.&lt;/li&gt;&lt;li&gt;Decision times in the app come from the simulated clock when a replay is running.&lt;/li&gt;&lt;/ol&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontColor=#0066CC;strokeColor=#0066CC;fillColor=#F0F6FF;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1240" y="1080" width="740" height="198" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>